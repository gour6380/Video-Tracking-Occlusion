# Local Python, notebook, editor and tool state
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# Credentials and machine-specific overrides
.env
.env.*
!.env.example
.secrets/
secrets/
.aws/
.ssh/
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
.netrc

# Runtime roots: never publish raw or licensed data, user uploads or generated exports
/data/
/runs/
/vendor/
/dist/
/build/
/uploads/
/outputs/
/submissions/
/checkpoints/
/logs/
/gradio_cached_examples/
/flagged/
/checkpoints_cache/
wandb/
events.out.tfevents.*
*.log

# Media, model weights and archives accidentally saved outside runtime roots
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.jpg
*.jpeg
*.png
*.tar
*.tar.*
*.tgz
*.gz
*.zip
*.7z
*.partial

# Publish only reviewed metadata/evidence in these otherwise local directories.
/artifacts/*
!/artifacts/upstream.json
/verification/*
!/verification/local-checks.json
!/verification/pre-upload-native-smoke.json
/reports/*
!/reports/README.md
